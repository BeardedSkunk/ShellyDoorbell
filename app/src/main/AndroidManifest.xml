<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Der Dauerdienst darf waehrend er laeuft den Standort nutzen (Homezone) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Noetig, damit die App in der "Nicht stoeren"-Zugriffsliste auftaucht -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Gewaehlter Alarmton: die Toene des Sound-Pickers liegen im MediaStore
         (Android/media/com.google.android.soundpicker/Alarms/). Ohne diese
         Berechtigung darf MediaPlayer sie nicht oeffnen — der Alarm faellt dann
         auf den langsamen Umweg ueber die Ringtone-API zurueck (mehrere Sekunden
         Stille vor dem ersten Ton, am Geraet gemessen). Optional: wird sie
         verweigert, greift weiterhin der Umweg. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- WLAN-Namen (SSID) lesen, um Heim- von Fremdnetzen zu unterscheiden.
         Ab Android 13 ohne Standort (neverForLocation); darunter via Standort. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Standort (optional): Homezone lernen/erkennen. Bis Android 12 zusaetzlich
         der Weg, um die SSID lesen zu duerfen. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Standort auch im Hintergrund („Immer zulassen"). Nur damit darf der
         Dauerdienst den FGS-Typ location auch dann setzen, wenn er AUS dem
         Hintergrund startet (Boot, App-Update). Fehlt sie, ist der Standort nur
         „waehrend der Nutzung" erlaubt: die Homezone arbeitet dann erst, nachdem
         die App einmal offen war, nach einem Handy-Neustart also gar nicht.
         Muss der Nutzer in den App-Infos erteilen, ein Dialog reicht ab
         Android 11 nicht mehr (siehe Einstellungen-Karte "Zuverlaessigkeit"). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Sichtbarkeit der Türsprecher-App (Android 11+): nur so lässt sich
         erkennen, ob deren "Tür öffnen"-Einsprung installiert ist. -->
    <queries>
        <intent>
            <action android:name="de.videoapp.action.OPEN_DOOR" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ShellyDoorbell"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Vollbild-Alarm, erscheint auch ueber dem Sperrbildschirm -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- Trampolin fuer die Notification-Action "Tuer ansehen": Alarm stoppen,
             dann Tuersprecher-App oeffnen -->
        <activity
            android:name=".OpenDoorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".service.DoorbellService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Haelt eine dauerhafte WebSocket-Verbindung zu einem Shelly-Geraet im Heimnetz, um Tuerklingel-Ereignisse sofort zu melden." />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
