<?xml version="1.0" encoding="utf-8"?>
<!-- Eigenes Layout NUR fuer Android 12+ (Pixel): dort ist das Header-Icon der
     Standard-Notification das nicht einfaerbbare App-Icon. Hier ahmen wir die
     Standard-Optik nach: Zeile 0 = kleines FARBIGES Icon + App-Name, darunter
     der Status-Text. (Auf Android <= 11 nutzen wir das echte Standard-Layout.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
